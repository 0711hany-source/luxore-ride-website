{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "outputDirectory": ".next",
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index_en.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/datenschutz.html",
      "destination": "/datenschutz",
      "permanent": true
    },
    {
      "source": "/hilfe.html",
      "destination": "/hilfe",
      "permanent": true
    }
  ]
}
